Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteRule ^api/tutor/?$ api/tutor.php [L,QSA]
RewriteRule ^api/search/?$ api/search.php [L,QSA]
RewriteRule ^api/flashcards/evaluate/?$ api/flashcards-evaluate.php [L,QSA]
RewriteRule ^api/answers/evaluate/?$ api/answers-evaluate.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

<FilesMatch "(^\.|\.env|\.log|\.json$)">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
